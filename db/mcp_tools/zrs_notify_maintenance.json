{
  "name": "notify_maintenance",
  "description": "Notify ZRS maintenance team about a reported issue with automatic priority assignment and vendor routing.",
  "category": "maintenance",
  "parameters": {
    "unit_number": {
      "type": "string",
      "description": "Unit reporting the issue",
      "required": true,
      "example": "404"
    },
    "issue": {
      "type": "string",
      "description": "Description of the problem",
      "required": true,
      "example": "leaking faucet in kitchen"
    },
    "priority": {
      "type": "string",
      "description": "Urgency level",
      "required": true,
      "enum": ["low", "medium", "high", "emergency"],
      "example": "medium"
    },
    "tenant_contact": {
      "type": "string",
      "description": "Tenant phone number for coordination",
      "required": false,
      "example": "555-0123"
    }
  },
  "command": "python tools/email_sender.py --template maintenance_request --unit '{{unit_number}}' --issue '{{issue}}' --priority '{{priority}}' --contact '{{tenant_contact}}'",
  "execution": {
    "timeout": 30,
    "retry_count": 2,
    "log_level": "INFO"
  },
  "output": {
    "work_order_created": "boolean",
    "work_order_id": "string",
    "assigned_technician": "string",
    "estimated_response_time": "string"
  },
  "escalation": {
    "emergency": "Immediate notification to on-call staff",
    "high": "2-hour response time target",
    "medium": "24-hour response time target", 
    "low": "72-hour response time target"
  }
}